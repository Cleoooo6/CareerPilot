# CareerPilot 环境变量模板。复制到项目根目录 .env 并填写真实值。
# .env 不得提交到 Git。

APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_USER_ID=demo-user

# 独立 PostgreSQL（CareerPilot 专用，不使用 DataPilot 的 DSN）
POSTGRES_PASSWORD=change-me-careerpilot
DATABASE_URL=postgresql://careerpilot:change-me-careerpilot@localhost:5433/careerpilot
TEST_DATABASE_URL=postgresql://careerpilot:change-me-careerpilot@localhost:5433/careerpilot_test

# LLM：阶段一默认 Mock，不发起真实请求。
# 经用户明确授权后才可将 LLM_MODE 改为 real，并在本机填写 LLM_API_KEY。
LLM_PROVIDER=zhipu
LLM_MODE=mock
LLM_MODEL=glm-4.7-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=1.0
# Docker 构建源（可选；中国大陆可改为镜像源）
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org